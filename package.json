{
  "name": "@fatwang2/dsh-projects",
  "version": "0.2.2",
  "type": "module",
  "description": "Adds a Projects board to the left sidebar. One goal, many parallel tasks: a coordinator splits the work, workers run each task in the project folder, and you review the results.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatwang2/dsh-projects.git"
  },
  "homepage": "https://github.com/fatwang2/dsh-projects#readme",
  "bugs": {
    "url": "https://github.com/fatwang2/dsh-projects/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./host/index.js",
    "./client": "./client/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host/index.js",
    "client/index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md"
  ],
  "scripts": {
    "check": "node --check host/index.js && node --check client/index.js",
    "test": "node --test test/host.test.mjs test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  }
}
